<Window x:Class="DLD.DroidGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DLD.DroidGuard.App.ViewModels"
        xmlns:local="clr-namespace:DLD.DroidGuard.App"
        Title="DLD DroidGuard — Android Security Suite"
        Width="1050" Height="780"
        MinWidth="850" MinHeight="600"
        Background="{StaticResource BackgroundDeepBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- State badge style -->
        <Style x:Key="StateBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource BadgeRadius}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource AccentSuccessBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- Header bar -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="28"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30"
                            Background="{StaticResource AccentGradientBrush}"
                            CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="D" FontSize="16" FontWeight="Bold"
                                   Foreground="#0D0F14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DLD DroidGuard"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Android Security &amp; Forensic Analysis"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top Action & ADB Pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 Export JSON Report"
                            Command="{Binding ExportReportCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,5" FontSize="11" Margin="0,0,12,0"
                            IsEnabled="{Binding CurrentSession, Converter={x:Static local:Converters.NotNullToBoolConverter}}"/>

                    <Border CornerRadius="12" Padding="12,5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#22EF4444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdbAvailable}" Value="True">
                                        <Setter Property="Background" Value="#2222C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AccentDangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdbAvailable}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentSuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="ADB: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding AdbStatusText}" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentDangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdbAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentSuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>

                <!-- DEVICE SELECTION & SUMMARY DASHBOARD -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Devices Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="CONNECTED DEVICE: " Style="{StaticResource SectionHeaderStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                          DisplayMemberPath="Serial" Width="200" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Refresh Devices" Command="{Binding RefreshDevicesCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="12,5" FontSize="11" Margin="0,0,8,0"/>
                                <Button Content="⟳  Quick Scan Packages" Command="{Binding ScanPackagesCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="14,5" FontSize="11"
                                        IsEnabled="{Binding HasSelectedDevice}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dashboard Summary Chips -->
                        <WrapPanel Grid.Row="1" Margin="0,4,0,0">
                            <Border Background="{StaticResource BackgroundElevatedBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total Apps: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding TotalAppsCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding UserAppsCount, StringFormat=' ({0} User'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SystemAppsCount, StringFormat=', {0} System)'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#2222C55E" CornerRadius="6" Padding="10,8" Margin="0,0,10,6">
                                <TextBlock Text="{Binding SafeCount, StringFormat='Safe: {0}'}" FontWeight="Bold" Foreground="{StaticResource AccentSuccessBrush}" FontSize="12"/>
                            </Border>
                            <Border Background="#22F59E0B" CornerRadius="6" Padding="10,8" Margin="0,0,10,6">
                                <TextBlock Text="{Binding HighCount, StringFormat='High Risk: {0}'}" FontWeight="Bold" Foreground="{StaticResource AccentWarningBrush}" FontSize="12"/>
                            </Border>
                            <Border Background="#22EF4444" CornerRadius="6" Padding="10,8" Margin="0,0,10,6">
                                <TextBlock Text="{Binding CriticalCount, StringFormat='Critical Risk: {0}'}" FontWeight="Bold" Foreground="{StaticResource AccentDangerBrush}" FontSize="12"/>
                            </Border>
                            <Border Background="#226366F1" CornerRadius="6" Padding="10,8" Margin="0,0,10,6">
                                <TextBlock Text="{Binding HiddenDetectionsCount, StringFormat='Hidden App: {0}'}" FontWeight="Bold" Foreground="#818CF8" FontSize="12"/>
                            </Border>
                            <Border Background="#22EC4899" CornerRadius="6" Padding="10,8" Margin="0,0,10,6">
                                <TextBlock Text="{Binding AdwareDetectionsCount, StringFormat='Adware Suspicion: {0}'}" FontWeight="Bold" Foreground="#F472B6" FontSize="12"/>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- SEARCH & FILTER TOOLBAR -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Search:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" FontSize="12"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" VerticalAlignment="Center" Padding="6,4" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Filter Category:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" FontSize="12"/>
                            <ComboBox SelectedValue="{Binding SelectedFilterCategory, Mode=TwoWay}" SelectedValuePath="Content" Width="140" VerticalAlignment="Center">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="User"/>
                                <ComboBoxItem Content="System"/>
                                <ComboBoxItem Content="Safe"/>
                                <ComboBoxItem Content="Low"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Critical"/>
                                <ComboBoxItem Content="Hidden"/>
                                <ComboBoxItem Content="Adware"/>
                                <ComboBoxItem Content="Sideload"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PACKAGE LIST DATAGRID -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="INSTALLED PACKAGES" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding FilteredApps}"
                                  SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Package Name" Binding="{Binding PackageName}" Width="*"/>
                                <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="75"/>
                                <DataGridTextColumn Header="Launcher" Binding="{Binding HasLauncherActivity}" Width="75"/>
                                <DataGridTextColumn Header="Installer" Binding="{Binding InstallerPackage, FallbackValue='—'}" Width="140"/>
                                <DataGridTextColumn Header="Risk Score" Binding="{Binding RiskAnalysis.RiskScore, FallbackValue='0'}" Width="80"/>
                                <DataGridTextColumn Header="Risk Level" Binding="{Binding RiskAnalysis.RiskLevel, FallbackValue='Safe'}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- SELECTED APP DETAIL & FORENSIC DEEP PANEL -->
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding HasSelectedApp, Converter={x:Static local:Converters.BoolToVisibleConverter}}">
                    <StackPanel>
                        <!-- Header Banner -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedApp.PackageName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SelectedApp.ApkPath, StringFormat='APK Path: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedApp.VersionName, StringFormat='Version: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding SelectedApp.TargetSdk, StringFormat='Target SDK: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding SelectedApp.SharedUserId, StringFormat='Shared UID: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="6" Padding="10,6" Margin="0,0,10,0" Background="{StaticResource BackgroundElevatedBrush}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedApp.RiskAnalysis.RiskScore, StringFormat='Score: {0}/100'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedApp.RiskAnalysis.Confidence, StringFormat='Conf: {0:P0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="6" Padding="12,6" Background="{StaticResource AccentGradientBrush}">
                                    <TextBlock Text="{Binding SelectedApp.RiskAnalysis.RiskLevel}" FontSize="13" FontWeight="Bold" Foreground="#0D0F14" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Action Toolbar -->
                        <Border Background="{StaticResource BackgroundElevatedBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="🔍 Run Deep Forensic &amp; Behavior Analysis"
                                        Command="{Binding RunDeepAnalysisCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontSize="11"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Remediation (Dry Run):" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" FontSize="11"/>
                                    <Button Content="Force Stop" Command="{Binding DryRunRemediationCommand}" CommandParameter="ForceStop" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="Clear Data" Command="{Binding DryRunRemediationCommand}" CommandParameter="ClearData" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="Disable App" Command="{Binding DryRunRemediationCommand}" CommandParameter="Disable" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="Uninstall App" Command="{Binding DryRunRemediationCommand}" CommandParameter="Uninstall" Style="{StaticResource PrimaryButtonStyle}" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Threat Detections -->
                        <TextBlock Text="HEURISTIC THREAT DETECTIONS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedApp.RiskAnalysis.Detections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22EF4444" BorderBrush="{StaticResource AccentDangerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource AccentDangerBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Confidence, StringFormat='Confidence: {0:P0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Recommendation}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Explainable Evidence Chain -->
                        <TextBlock Text="EXPLAINABLE RISK EVIDENCE CHAIN" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedApp.RiskAnalysis.Evidences}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Points, StringFormat='+{0}'}" FontWeight="Bold" Foreground="{StaticResource AccentWarningBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Deep Forensic & Runtime Reports -->
                        <Expander Header="APK &amp; SIGNATURE FORENSIC REPORT" IsExpanded="True" Margin="0,10,0,0">
                            <Border Background="{StaticResource BackgroundElevatedBrush}" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SelectedApp.ForensicReport.Evidence}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Run Deep Analysis to extract APK size, flags, and signature certs." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2"
                                               Visibility="{Binding SelectedApp.ForensicReport, Converter={x:Static local:Converters.EmptyStringToVisibleConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander Header="RUNTIME PROCESS &amp; SERVICE VISIBILITY" IsExpanded="True" Margin="0,6,0,0">
                            <Border Background="{StaticResource BackgroundElevatedBrush}" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SelectedApp.RuntimeReport.RunningProcesses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='[Process] {0}'}" Foreground="{StaticResource AccentSuccessBrush}" FontSize="11" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Run Deep Analysis to inspect active runtime PIDs and background services." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2"
                                               Visibility="{Binding SelectedApp.RuntimeReport, Converter={x:Static local:Converters.EmptyStringToVisibleConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander Header="DYNAMIC BEHAVIOR ANALYSIS &amp; CORRELATION TIMELINE" IsExpanded="True" Margin="0,6,0,0">
                            <Border Background="{StaticResource BackgroundElevatedBrush}" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SelectedApp.CorrelatedAssessment.Timeline}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Category, StringFormat='[{0}]'}" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Run Deep Analysis to generate dynamic behavioral timeline." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2"
                                               Visibility="{Binding SelectedApp.CorrelatedAssessment, Converter={x:Static local:Converters.EmptyStringToVisibleConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Expander>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- REMEDIATION CONFIRMATION / DRY RUN MODAL OVERLAY -->
        <Grid Grid.RowSpan="3" Background="#AA000000" Visibility="{Binding ShowRemediationModal, Converter={x:Static local:Converters.BoolToVisibleConverter}}">
            <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource BackgroundCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="REMEDIATION CONFIRMATION" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentWarningBrush}" Margin="0,0,0,12"/>

                    <Border Background="{StaticResource BackgroundElevatedBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding RemediationPreview.PackageName, StringFormat='Package: {0}'}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding RemediationPreview.Action, StringFormat='Action: {0}'}" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding RemediationPreview.Command, StringFormat='Command: {0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding RemediationPreview.Output}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelRemediationCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" Margin="0,0,10,0"/>
                        <Button Content="Confirm Execution" Command="{Binding ConfirmRemediationCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Margin="0,0,5,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="DLD Agency Media"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
