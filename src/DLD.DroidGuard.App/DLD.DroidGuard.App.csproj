<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DLD.DroidGuard</AssemblyName>
    <RootNamespace>DLD.DroidGuard.App</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DLD.DroidGuard.Core\DLD.DroidGuard.Core.csproj" />
    <ProjectReference Include="..\DLD.DroidGuard.Adb\DLD.DroidGuard.Adb.csproj" />
    <ProjectReference Include="..\DLD.DroidGuard.Infrastructure\DLD.DroidGuard.Infrastructure.csproj" />
  </ItemGroup>

</Project>
